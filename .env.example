# Provedor de PIX. "mock" para testes locais.
# Quando plugar o seu, troque para o nome que voce registrar em src/pix/provider.js
PIX_PROVIDER=mock

# Dados do produto exibidos no checkout.
PRODUCT_NAME=Programa Livre de Apostas - Acesso completo
PRODUCT_PRICE_CENTS=4990

# Porta do servidor.
PORT=3000

# --- Quando plugar o seu provedor, adicione as credenciais dele aqui ---
# PIX_API_URL=
# PIX_API_KEY=
