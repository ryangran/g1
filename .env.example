# Provedor de PIX. "mock" para testes locais, "nomapay" em producao.
PIX_PROVIDER=mock

# Dados do produto exibidos no checkout.
PRODUCT_NAME=Programa Livre de Apostas - Acesso completo
PRODUCT_PRICE_CENTS=4990

# Porta do servidor.
PORT=3000

# --- NOMAPAY Gateway (necessario quando PIX_PROVIDER=nomapay) ---
NOMAPAY_PUBLIC_KEY=fsp_pk_live_...
NOMAPAY_SECRET_KEY=fsp_sk_live_...
# Opcional: sobrescreve a base URL (padrao: https://nomaofficial.com.br/api/v1)
# NOMAPAY_BASE_URL=https://nomaofficial.com.br/api/v1
# Segredo para validar o HMAC do webhook (padrao: usa a secret key)
# NOMAPAY_WEBHOOK_SECRET=
# URL que o gateway chama nos eventos (aponte para /api/webhook do seu deploy)
# NOMAPAY_POSTBACK_URL=https://seusite.com.br/api/webhook
